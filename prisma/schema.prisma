generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id       Int    @id @default(autoincrement())
  user_email    String @unique
  user_password String
  mem_id        Int

  // Relations
  member        Member @relation(fields: [mem_id], references: [mem_id])
  participations Participation[]
  files         File[]
  records       Record[]
}

model Publication {
  pub_id     Int    @id @default(autoincrement())
  pub_title  String
  pub_description  String
  pub_year   Int
  pub_status Int
  pub_type   Int   

  // Relations
  participations Participation[]
  manages        Manage[]
  files          File[]
}

model Participation {
  part_id     Int   @id @default(autoincrement())
  pub_id      Int
  user_id     Int?        // nullable FK
  co_name     String?     // nullable text
  part_status Int

  // Relations
  publication Publication @relation(fields: [pub_id], references: [pub_id])
  user        User?       @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  //         ^^^^^ make relation optional as well (and optional: set null on delete)
  
  @@index([user_id])
  @@index([pub_id])
}


model Member {
  mem_id    Int    @id @default(autoincrement())
  mem_fname String
  mem_lname String
  mem_phone String
  mem_type  Int

  // Relations
  users User[]
}

model Manage {
  manage_id     Int    @id @default(autoincrement())
  manage_detail String
  manage_date   DateTime
  manage_type   Int
  pub_id        Int

  // Relations
  publication Publication @relation(fields: [pub_id], references: [pub_id])
}

// If you want to be explicit about type:
enum FileKind {
  PDF
  OTHER
}

model File {
  file_id      Int       @id @default(autoincrement())
  file_name    String                // original name shown in your UI
  file_url     String                // where the file actually lives (S3/Supabase/etc.)
  file_mime    String   @default("application/pdf")
  file_ext     String   @default("pdf")
  file_size    Int                  // bytes
  checksum     String?  @unique     // sha256 (optional, helps dedupe/integrity)
  kind         FileKind @default(PDF)
  uploaded_at  DateTime @default(now())

  user_id      Int
  pub_id       Int

  // Relations
  user         User        @relation(fields: [user_id], references: [user_id])
  publication  Publication @relation(fields: [pub_id], references: [pub_id])

  // Helpful indexes for listing
  @@index([pub_id, uploaded_at])
  @@index([user_id, uploaded_at])

  // Optional: prevent same name twice in a publication
  // @@unique([pub_id, file_name])
}

model Record {
  record_id  Int      @id @default(autoincrement())
  login_time DateTime
  user_id    Int

  // Relations
  user User @relation(fields: [user_id], references: [user_id])
}